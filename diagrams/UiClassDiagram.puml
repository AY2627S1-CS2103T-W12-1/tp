@startuml
!pragma layout smetana
!include style.puml
' Two aligned rows of UiParts keep the diagram narrow.
skinparam linetype polyline
skinparam groupInheritance 2
skinparam nodesep 40
skinparam ranksep 55
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI <<Rectangle>>{
Class "<<interface>>\nUi" as Ui
Class "{abstract}\nUiPart" as UiPart
Class UiManager
Class MainWindow
Class HelpWindow
Class ResultDisplay
Class PersonListPanel
Class MemberDetailsPanel
Class PersonCard
Class StatusBarFooter
Class CommandBox
}

package Model <<Rectangle>> {
}

package Logic <<Rectangle>> {
}

UiManager .up.|> Ui
UiManager -down-> "1" MainWindow
MainWindow *-down->  "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" PersonListPanel
MainWindow *-down-> "1" MemberDetailsPanel
MainWindow *-down-> "1" StatusBarFooter
MainWindow --> "1" HelpWindow

PersonListPanel -down-> "*" PersonCard

MainWindow --|> UiPart

ResultDisplay --|> UiPart
CommandBox --|> UiPart
PersonListPanel --|> UiPart
MemberDetailsPanel --|> UiPart
PersonCard --|> UiPart
StatusBarFooter --|> UiPart
HelpWindow --|> UiPart

PersonCard ..> Model
MemberDetailsPanel ..> Model
HelpWindow ..> Logic
UiManager -right-> Logic
MainWindow -left-> Logic
MainWindow ..> Model

' First row: HelpWindow, CommandBox, ResultDisplay. Second row: the remaining parts.
HelpWindow -[hidden]right-> CommandBox
CommandBox -[hidden]right-> ResultDisplay
StatusBarFooter -[hidden]right-> MemberDetailsPanel
MemberDetailsPanel -[hidden]right-> PersonListPanel
CommandBox -[hidden]down-> MemberDetailsPanel
@enduml
