@startuml
!include style.puml
skinparam ArrowFontStyle plain
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":ClearCommand" as Clear LOGIC_COLOR
participant ":Model" as Model MODEL_COLOR
participant ":Storage" as Storage STORAGE_COLOR
[-> Logic : execute("clear" or "clear /all")
activate Logic
Logic -> Clear : prepareTargets(model)
activate Clear
Clear -> Model : getFilteredPersonList() or getAddressBook()
activate Model
Model --> Clear : members
deactivate Model
Clear --> Logic : captured target count
deactivate Clear
Logic -->[ : scope/count confirmation prompt
deactivate Logic
[-> Logic : execute("yes")
activate Logic
Logic -> Model : getAddressBook()
activate Model
Model --> Logic : beforeClear snapshot
deactivate Model
Logic -> Clear : execute(model)
activate Clear
Clear -> Model : setAddressBook(non-target members)
activate Model
Model --> Clear : return
deactivate Model
note right of Model : Preserve conditions until save succeeds
Clear --> Logic : result
deactivate Clear
Logic -> Storage : saveAddressBook(remaining roster)
activate Storage
alt save succeeds
Storage --> Logic : saved
deactivate Storage
Logic -> Clear : finishSaving(model)
activate Clear
alt displayed clearing
Clear -> Model : removeDeletedPersonsFromSelections(targets)
activate Model
Model --> Clear : return
deactivate Model
note right of Model : Retain conditions; update Show counts
else whole-roster clearing
Clear -> Model : updateFilteredPersonList(SHOW_ALL)
activate Model
Model --> Clear : return
deactivate Model
end
Clear --> Logic : return
deactivate Clear
Logic -->[ : cleared count
else save fails
activate Storage
Storage --> Logic : IOException
deactivate Storage
Logic -> Model : setAddressBook(beforeClear)
activate Model
Model --> Logic : return
deactivate Model
Logic -->[ : save error; no members removed
end
deactivate Logic
@enduml
