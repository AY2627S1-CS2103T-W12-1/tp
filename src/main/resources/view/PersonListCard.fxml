<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" minWidth="0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <VBox spacing="8" minWidth="0" minHeight="-Infinity" HBox.hgrow="ALWAYS">
    <padding><Insets top="12" right="14" bottom="12" left="14" /></padding>
    <HBox spacing="8" alignment="TOP_LEFT" minWidth="0" minHeight="-Infinity">
      <Label fx:id="id" styleClass="member-index" minWidth="24" />
      <Label fx:id="name" styleClass="member-name" wrapText="true" minWidth="0" HBox.hgrow="ALWAYS" />
    </HBox>
    <FlowPane fx:id="tags" hgap="6" vgap="6" minWidth="0" />
  </VBox>
</HBox>
