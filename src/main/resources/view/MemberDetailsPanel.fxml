<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="12" minWidth="0" minHeight="0" styleClass="member-details-panel"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
  <Label text="MEMBER DETAILS" styleClass="panel-heading" />
  <StackPane VBox.vgrow="ALWAYS" minWidth="0" minHeight="0">
    <Label fx:id="emptyState" text="Select a member to reveal their contact details."
           wrapText="true" styleClass="details-empty-state" />
    <ScrollPane fx:id="detailsScroll" fitToWidth="true" hbarPolicy="NEVER" minWidth="0" minHeight="0">
      <VBox spacing="16" minWidth="0">
        <padding><Insets top="6" right="6" bottom="8" left="6" /></padding>
        <VBox spacing="4" minWidth="0">
          <Label fx:id="displayedIndex" styleClass="details-index" />
          <Label fx:id="name" wrapText="true" styleClass="details-name" />
        </VBox>
        <VBox spacing="5" minWidth="0">
          <Label text="PHONE" styleClass="member-field-label" />
          <HBox spacing="8" alignment="CENTER_LEFT" minWidth="0">
            <Label fx:id="phone" wrapText="true" minWidth="0" HBox.hgrow="ALWAYS"
                   styleClass="member-field-value" />
            <Button fx:id="copyPhoneButton" accessibleText="Copy phone"
                    onAction="#copyPhone" styleClass="copy-button">
              <graphic><SVGPath content="M6 2 H15 V13 H6 Z M3 5 H12 V16 H3 Z" styleClass="copy-icon" /></graphic>
              <tooltip><Tooltip text="Copy phone" /></tooltip>
            </Button>
          </HBox>
        </VBox>
        <VBox spacing="5" minWidth="0">
          <Label text="EMAIL" styleClass="member-field-label" />
          <HBox spacing="8" alignment="CENTER_LEFT" minWidth="0">
            <Label fx:id="email" wrapText="true" minWidth="0" HBox.hgrow="ALWAYS"
                   styleClass="member-field-value" />
            <Button fx:id="copyEmailButton" accessibleText="Copy email"
                    onAction="#copyEmail" styleClass="copy-button">
              <graphic><SVGPath content="M6 2 H15 V13 H6 Z M3 5 H12 V16 H3 Z" styleClass="copy-icon" /></graphic>
              <tooltip><Tooltip text="Copy email" /></tooltip>
            </Button>
          </HBox>
        </VBox>
        <VBox spacing="5" minWidth="0">
          <Label text="ADDRESS" styleClass="member-field-label" />
          <HBox spacing="8" alignment="CENTER_LEFT" minWidth="0">
            <Label fx:id="address" wrapText="true" minWidth="0" HBox.hgrow="ALWAYS"
                   styleClass="member-field-value" />
            <Button fx:id="copyAddressButton" accessibleText="Copy address"
                    onAction="#copyAddress" styleClass="copy-button">
              <graphic><SVGPath content="M6 2 H15 V13 H6 Z M3 5 H12 V16 H3 Z" styleClass="copy-icon" /></graphic>
              <tooltip><Tooltip text="Copy address" /></tooltip>
            </Button>
          </HBox>
        </VBox>
        <VBox spacing="5" minWidth="0">
          <Label text="TAGS" styleClass="member-field-label" />
          <FlowPane fx:id="tags" hgap="6" vgap="6" minWidth="0" />
        </VBox>
      </VBox>
    </ScrollPane>
  </StackPane>
</VBox>
