@startuml
!include style.puml
skinparam ArrowFontStyle plain
participant ":LogicManager" as logic LOGIC_COLOR
participant "command:ClearCommand" as command LOGIC_COLOR
participant "model:Model" as model MODEL_COLOR
participant "storage:Storage" as storage STORAGE_COLOR

[-> logic : execute("clear")
activate logic
note over logic, command: Parsing omitted; command is ClearCommand.
logic -> model : getAddressBook()
activate model
model --> logic : currentRoster
deactivate model
note left of logic: beforeClear = new AddressBook(currentRoster)
logic -> command : execute(model)
activate command
command -> model : getAddressBook()
activate model
model --> command : currentRoster
note left of command: Count currentRoster.getPersonList().size()
deactivate model
command -> model : setAddressBook(new AddressBook())
activate model
model --> command
deactivate model
command --> logic : result with count
deactivate command
note over logic, command: isReadOnly() is false.
logic -> model : getAddressBook()
activate model
model --> logic : emptyRoster
deactivate model
logic -> storage : saveAddressBook(emptyRoster)
activate storage
storage --> logic : return or throw IOException
deactivate storage
alt save succeeds
    logic -> model : updateFilteredPersonList(SHOW_ALL)
    activate model
    model --> logic
    deactivate model
    logic -->[ : result
else IOException
    logic -> model : setAddressBook(beforeClear)
    activate model
    model --> logic
    deactivate model
    logic -->[ : throws SaveFailureException\n(changeApplied=false)
end
deactivate logic
note over model: Predicates and comparator are retained during execution.\nSuccess clears predicates; failure restores records under the old view.
@enduml
