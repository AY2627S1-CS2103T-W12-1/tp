@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR_T4
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

Class "<<interface>>\nStorage" as Storage
Class StorageManager
Class AppInstanceLock

package "UserPrefs Storage" #F5EFE5{
Class JsonUserPrefsStorage
}

package "AddressBook Storage" #F5EFE5{
Class JsonAddressBookStorage
Class JsonSerializableAddressBook
Class JsonAdaptedPerson
Class JsonAdaptedTag
}

package "CSV Import and Export" #F5EFE5{
Class CsvAddressBookImporter
Class CsvAddressBookExporter
Class CsvAddressBookCsv
Class CsvImportException
}

}

package Main {
Class MainApp #E8E0D5
}

package Logic {
Class ImportCommand LOGIC_COLOR
Class ExportCommand LOGIC_COLOR
}


MainApp --> "0..1" AppInstanceLock : session lock
StorageManager .up.|> Storage
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonAddressBookStorage

JsonAddressBookStorage ..> JsonSerializableAddressBook
JsonSerializableAddressBook --> "*" JsonAdaptedPerson
JsonAdaptedPerson --> "*" JsonAdaptedTag

ImportCommand ..> CsvAddressBookImporter
ExportCommand ..> CsvAddressBookExporter
CsvAddressBookImporter ..> CsvAddressBookCsv
CsvAddressBookExporter ..> CsvAddressBookCsv
CsvAddressBookImporter ..> CsvImportException : <<throws>>

@enduml
