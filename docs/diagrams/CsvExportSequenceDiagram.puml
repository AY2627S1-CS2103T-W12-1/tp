@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam DefaultFontSize 15
mainframe sd ExportRoster
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":ExportCommand" as Command LOGIC_COLOR
participant "model:Model" as Model MODEL_COLOR
participant "<<class>>\nCsvAddressBookExporter" as Exporter STORAGE_COLOR
[-> Logic : execute(commandText)
activate Logic
note over Logic,Command : Parsing has produced an ExportCommand.
Logic -> Command : execute(model, protectedFiles)
activate Command
Command -> Model : getAddressBook().getPersonList()
Model --> Command : complete roster in stored order
ref over Command : CheckExportDestination
Command -> Exporter : export(people, targetPath)
activate Exporter
ref over Exporter : WriteCsvAtomically
Exporter --> Command : return
deactivate Exporter
Command --> Logic : CommandResult(count, path)
deactivate Command
Logic -> Command : isReadOnly()
Command --> Logic : true
Logic -->[ : CommandResult
deactivate Logic
note over Logic,Model : The roster, filters and sorting remain unchanged.
@enduml
