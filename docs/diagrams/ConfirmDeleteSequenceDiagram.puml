@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant "c:ConfirmDeleteCommand" as Command LOGIC_COLOR
end box
box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box
box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> Logic : execute("yes")
activate Logic
note over Logic
Clear pending deletion;
do not parse "yes".
end note
Logic -> Command : execute(m)
activate Command
Command -> Model : getAddressBook()
activate Model
Model --> Command : roster
deactivate Model
note over Command, Model: Check the prompted member still exists.
Command -> Model : deletePerson(target)
activate Model
Model --> Command
deactivate Model
Command --> Logic : deletion result
deactivate Command
Logic -> Command : isReadOnly()
activate Command
Command --> Logic : false
deactivate Command
Logic -> Model : getAddressBook()
activate Model
Model --> Logic : updated roster
deactivate Model
Logic -> Storage : saveAddressBook(roster)
activate Storage
Storage --> Logic
deactivate Storage
[<-- Logic : deletion result
deactivate Logic
@enduml
