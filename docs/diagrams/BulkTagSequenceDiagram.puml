@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":TagAllCommandParser" as TagAllCommandParser LOGIC_COLOR
participant "t:TagAllCommand" as TagAllCommand LOGIC_COLOR
end box
box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box
box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("tagall t/event")
activate LogicManager
LogicManager -> AddressBookParser : parseCommand("tagall t/event")
activate AddressBookParser
create TagAllCommandParser
AddressBookParser -> TagAllCommandParser : TagAllCommandParser()
activate TagAllCommandParser
TagAllCommandParser --> AddressBookParser
deactivate TagAllCommandParser
AddressBookParser -> TagAllCommandParser : parse(" t/event")
activate TagAllCommandParser
note right of TagAllCommandParser : BulkTagArgumentParser#parse\nchecks exactly one valid tag.
create TagAllCommand
TagAllCommandParser -> TagAllCommand : TagAllCommand(tag)
activate TagAllCommand
TagAllCommand --> TagAllCommandParser
deactivate TagAllCommand
TagAllCommandParser --> AddressBookParser : t
deactivate TagAllCommandParser
AddressBookParser --> LogicManager : t
deactivate AddressBookParser
LogicManager -> TagAllCommand : execute(m)
activate TagAllCommand
TagAllCommand -> Model : getFilteredPersonList()
activate Model
Model --> TagAllCommand : displayed members
deactivate Model
note right of TagAllCommand : Copy the list to fix the target set.
loop each target p that lacks the tag
TagAllCommand -> Model : setPerson(p, updated)
activate Model
Model --> TagAllCommand
deactivate Model
end
TagAllCommand --> LogicManager : result with counts
deactivate TagAllCommand
LogicManager -> Storage : saveAddressBook(roster)
activate Storage
Storage --> LogicManager
deactivate Storage
[<-- LogicManager : result with counts
deactivate LogicManager
@enduml
