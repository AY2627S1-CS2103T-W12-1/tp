---
layout: null
permalink: /search-index.json
---
[
  {% assign regular_pages = site.pages | where: 'layout', 'page' %}
  {% assign alt_pages = site.pages | where: 'layout', 'alt-page' %}
  {% assign documentation = regular_pages | concat: alt_pages %}
  {% for document in documentation %}
  {
    "title": {{ document.title | default: document.alt_title | jsonify }},
    "url": {{ document.url | relative_url | jsonify }},
    "html": {{ document.content | markdownify | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
