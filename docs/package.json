{
  "name": "trackcall-documentation",
  "version": "1.0.0",
  "private": true,
  "description": "TrackCall project documentation built with MarkBind",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "test": "node --test scripts/test-dependencies.mjs",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify-site.mjs",
    "serve": "markbind serve --port 8080"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "markbind-cli": "7.2.1",
    "patch-package": "8.0.1"
  },
  "overrides": {
    "chokidar": "3.6.0",
    "csv-parse": "7.0.3",
    "decode-uri-component": "0.5.1",
    "katex": "0.19.1",
    "linkify-it": "5.0.2",
    "lodash.pick": "npm:lodash@4.18.1",
    "markdown-it": "14.3.3",
    "nth-check": "2.1.1",
    "simple-git": "4.0.2",
    "uuid": "11.1.1",
    "vue": "3.5.44"
  }
}
